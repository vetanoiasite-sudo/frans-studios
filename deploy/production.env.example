# Production settings for Frans Studios — EXAMPLE ONLY. Never commit real values.
# Set these as environment variables for the IIS application pool (see docs/DEPLOYMENT.md §4).
# ASP.NET Core maps "__" (double underscore) to configuration sections.

# ── Required ────────────────────────────────────────────────────────────────
ConnectionStrings__Default=Server=localhost;Database=FransStudios;User Id=fransstudios_app;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False
Site__PublicBaseUrl=https://fransstudios.com
Storage__PublicMediaPath=D:\FransStudios\data\public-media
Storage__PrivateCachePath=D:\FransStudios\data\private-cache
Storage__DataProtectionKeysPath=D:\FransStudios\data\keys

# ── Google Drive (from Google Cloud Console → Credentials → OAuth client "Web application") ──
GoogleDrive__ClientId=CHANGE_ME.apps.googleusercontent.com
GoogleDrive__ClientSecret=CHANGE_ME

# ── Optional: email notifications for new inquiries (Provider=None just logs) ──
Email__Provider=None
# Email__Provider=Smtp
# Email__FromAddress=no-reply@fransstudios.com
# Email__NotifyAddress=Frans.Weddings@gmail.com
# Email__Smtp__Host=smtp.gmail.com
# Email__Smtp__Port=587
# Email__Smtp__Username=CHANGE_ME
# Email__Smtp__Password=CHANGE_ME_APP_PASSWORD

# ── Optional: only if a proxy/CDN (e.g. Cloudflare) sits in front of IIS ──
# ReverseProxy__KnownProxies__0=10.0.0.5
