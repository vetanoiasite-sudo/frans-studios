    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>47b879ff-c097-47be-ab7d-b26e25a1d528</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
