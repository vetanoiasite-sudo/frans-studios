{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=FransStudios;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },

  "Database": {
    "MigrateOnStartup": true
  },

  "Site": {
    "PublicBaseUrl": "http://localhost:5173"
  },

  "Storage": {
    "PublicMediaPath": "App_Data/public-media",
    "PrivateCachePath": "App_Data/private-cache",
    "DataProtectionKeysPath": "App_Data/keys"
  }
}
